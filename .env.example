# SQLite for local/dev. Swap to a Postgres URL later for production/multi-user use.
DATABASE_URL="file:./prisma/dev.db"

# Which LLM provider parses receipt images. See src/lib/llm/index.ts.
LLM_PROVIDER="anthropic"

# Required when LLM_PROVIDER="anthropic". Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
