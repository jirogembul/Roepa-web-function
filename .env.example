# SQLite for local/dev. Swap to a Postgres URL later for production/multi-user use.
DATABASE_URL="file:./prisma/dev.db"

# Which LLM reads the receipt photos: "gemini" or "anthropic".
# See src/lib/llm/index.ts — each provider is one adapter file.
LLM_PROVIDER="gemini"

# Required when LLM_PROVIDER="gemini". Free tier, no card needed:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the model (default "gemini-3.6-flash"). If parsing fails
# with a 404, the error names the model to use here.
# GEMINI_MODEL=""

# Required when LLM_PROVIDER="anthropic". https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Optional: defaults to "claude-sonnet-5"
# ANTHROPIC_MODEL=""
